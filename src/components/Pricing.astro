---
import { supabase } from '../lib/supabase';

// Lekérjük a kategóriákat és a hozzájuk tartozó árakat
const { data: categories } = await supabase
  .from('price_categories')
  .select('*, prices(*)')
  .order('display_order', { ascending: true });

const displayCategories = categories || [];
---

<section id="arak" class="py-24 px-4 bg-pink-50/30">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-serif font-bold text-slate-900 mb-4 tracking-tight">Szolgáltatások & Árak</h2>
      <div class="w-20 h-1 bg-pink-500 mx-auto rounded-full"></div>
    </div>

    <div class="space-y-12">
      {displayCategories.map((group) => (
        <div class="bg-white p-8 md:p-12 rounded-[2.5rem] shadow-sm border border-pink-100 transition-all duration-500 hover:shadow-xl">
          <h3 class="text-2xl font-serif font-bold text-pink-600 mb-8 flex items-center">
            <span class="mr-4">{group.name}</span>
            <div class="grow h-px bg-pink-100"></div>
          </h3>
          
          <div class="grid gap-8">
            {group.prices && group.prices.sort((a, b) => a.display_order - b.display_order).map((item) => (
              <div class="flex justify-between items-start group">
                <div class="max-w-[70%]">
                  <h4 class="text-lg font-semibold text-slate-800 group-hover:text-pink-600 transition-colors">
                    {item.service_name}
                  </h4>
                  {item.description && (
                    <p class="text-sm text-slate-500 mt-1 italic font-light">{item.description}</p>
                  )}
                </div>
                <div class="text-right">
                  <span class="text-xl font-bold text-slate-900">{item.price_value}</span>
                  <span class="text-[10px] font-bold text-pink-400 block uppercase tracking-tighter">HUF</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="text-center mt-12 text-slate-400 text-sm italic">
      Az árlista 2026.08.01-től visszavonásig érvényes
    </p>
  </div>
</section>