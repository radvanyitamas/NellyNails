---
// src/components/Contact.astro
import { supabase } from '../lib/supabase';

const { data: settings } = await supabase.from('site_settings').select('*');

const contact = settings?.find(s => s.key === 'contact')?.value || {
  phone: "+36 30 433 0624",
  email: "radvanyi.tamas910105@gmail.com",
  zip: "6721",
  city: "Szeged",
  street: "Hullám utca",
  houseNumber: "3."
};

const hours = settings?.find(s => s.key === 'hours')?.value || {
  workdays: "15:00 - 20:00",
  weekends: "10:00 - 15:00"
};
---

<section id="kapcsolat" class="py-24 px-4 bg-white relative">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      
      <div class="space-y-12">
        <div>
          <h2 class="text-4xl font-serif font-bold text-slate-900 mb-6 tracking-tight">Kapcsolat</h2>
          <p class="text-slate-600 mb-10 leading-relaxed italic">
            Kérdésed van vagy időpontot foglalnál? Keress bizalommal az alábbi elérhetőségeken!
          </p>
          
          <div class="space-y-8">
            <div class="flex items-center space-x-5 group">
              <div class="w-14 h-14 bg-pink-100 rounded-2xl flex items-center justify-center text-pink-600 group-hover:bg-pink-600 group-hover:text-white transition-all duration-300 shadow-sm">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-[0.2em] mb-1">Hívj bátran</p>
                <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="text-xl font-bold text-slate-800 hover:text-pink-600 transition-colors tracking-tight">{contact.phone}</a>
              </div>
            </div>

            <div class="flex items-center space-x-5 group">
              <div class="w-14 h-14 bg-pink-100 rounded-2xl flex items-center justify-center text-pink-600 group-hover:bg-pink-600 group-hover:text-white transition-all duration-300 shadow-sm">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-[0.2em] mb-1">Írj nekem</p>
                <a href={`mailto:${contact.email}`} class="text-lg font-semibold text-slate-800 hover:text-pink-600 transition-colors">{contact.email}</a>
              </div>
            </div>

            <div class="flex items-center space-x-5 group">
               <div class="w-14 h-14 bg-pink-100 rounded-2xl flex items-center justify-center text-pink-600 group-hover:bg-pink-600 group-hover:text-white transition-all duration-300 shadow-sm">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-[0.2em] mb-1">Helyszín</p>
                <p class="text-lg font-semibold text-slate-800">{contact.zip} {contact.city}, {contact.street} {contact.houseNumber}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-slate-50 p-8 rounded-[2.5rem] border border-slate-100 shadow-sm">
          <h3 class="text-xl font-bold mb-6 text-slate-800 flex items-center">
            <span class="w-2 h-2 bg-pink-500 rounded-full mr-3"></span> Nyitvatartás
          </h3>
          <div class="space-y-4">
            <div class="flex justify-between border-b border-slate-200 pb-3 italic text-sm">
              <span class="text-slate-500 font-light">Hétfő - Péntek</span>
              <span class="text-slate-900 font-bold">{hours.workdays}</span>
            </div>
            <div class="flex justify-between border-b border-slate-200 pb-3 italic text-sm">
              <span class="text-slate-500 font-light">Szombat - Vasárnap</span>
              <span class="text-slate-900 font-bold">{hours.weekends}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-slate-50 p-8 md:p-12 rounded-[2.5rem] border border-pink-100 shadow-xl relative overflow-hidden">
        <form id="booking-form" class="space-y-6" data-hours={JSON.stringify(hours)}>
          <div class="space-y-4">
            <input type="text" name="name" required placeholder="Teljes név" class="w-full p-4 rounded-2xl bg-white border-none ring-1 ring-slate-200 focus:ring-2 focus:ring-pink-500 outline-none transition-all shadow-sm" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <input type="email" name="email" required placeholder="E-mail" class="w-full p-4 rounded-2xl bg-white border-none ring-1 ring-slate-200 focus:ring-2 focus:ring-pink-500 transition-all shadow-sm" />
              <input type="tel" name="phone" required placeholder="Telefon" class="w-full p-4 rounded-2xl bg-white border-none ring-1 ring-slate-200 focus:ring-2 focus:ring-pink-500 transition-all shadow-sm" />
            </div>
          </div>

          <div class="space-y-4">
            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">1. Nap kiválasztása</label>
            <div id="calendar-container" class="rounded-3xl overflow-hidden shadow-inner ring-1 ring-slate-200 bg-white p-2 min-h-[300px]">
                <input type="text" id="inline-calendar" required class="hidden" />
            </div>
          </div>

          <div id="time-selection" class="space-y-4 hidden">
            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">2. Szabad időpontok (3 órás blokk)</label>
            <div id="time-slots" class="grid grid-cols-4 gap-2"></div>
            <input type="hidden" name="date" id="final-date-input" required />
          </div>
          
          <button type="submit" id="submit-btn" class="w-full py-5 bg-pink-600 text-white font-bold rounded-2xl hover:bg-pink-700 hover:shadow-2xl active:scale-95 transition-all flex items-center justify-center disabled:bg-slate-300 shadow-lg shadow-pink-100">
            <span>Időpont véglegesítése</span>
          </button>
        </form>
        <div id="status-container" class="mt-6 hidden p-6 rounded-3xl text-center font-bold border"></div>
      </div>
    </div>

    <div class="mt-16 rounded-[3rem] overflow-hidden shadow-2xl h-[450px] border-8 border-white ring-1 ring-slate-100">
      <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2758.123!2d20.147!3d46.253!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDbCsDE1JzExLjAiTiAyMMKwMDgnNDkuMiJF!5e0!3m2!1shu!2shu!4v123456789" 
        class="w-full h-full border-0" 
        allowfullscreen="" 
        loading="lazy"
      ></iframe>
    </div>
  </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script is:inline src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script>
  const hu = {
    weekdays: { shorthand: ["V", "H", "K", "Sz", "Cs", "P", "Sz"], longhand: ["Vasárnap", "Hétfő", "Kedd", "Szerda", "Csütörtök", "Péntek", "Szombat"] },
    months: { shorthand: ["Jan", "Feb", "Már", "Ápr", "Máj", "Jún", "Júl", "Aug", "Szep", "Okt", "Nov", "Dec"], longhand: ["Január", "Február", "Március", "Április", "Május", "Június", "Július", "Augusztus", "Szeptember", "Október", "November", "December"] },
    firstDayOfWeek: 1, ordinal: () => "."
  };

  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const slotsDiv = document.getElementById('time-slots');
  const selectionArea = document.getElementById('time-selection');
  const finalInput = document.getElementById('final-date-input') as HTMLInputElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  const hoursData = JSON.parse(form?.dataset.hours || '{}');
  let bookedTimestamps: number[] = [];

  async function fetchBookedSlots() {
    try {
      const resp = await fetch('/api/get-slots');
      if (resp.ok) {
        const data = await resp.json();
        bookedTimestamps = data.map((d: string) => new Date(d).getTime());
      }
    } catch (e) { console.error("Hiba:", e); }
  }

  function generateSlots(day: Date) {
    if (!slotsDiv || !selectionArea) return;
    slotsDiv.innerHTML = '';
    selectionArea.classList.remove('hidden');

    const now = new Date(); // Aktuális idő lekérése az összehasonlításhoz

    const dayNum = day.getDay();
    const isWeekend = (dayNum === 0 || dayNum === 6);
    const range = isWeekend ? hoursData.weekends : hoursData.workdays;
    
    const [startStr, endStr] = range.split(' - ');
    const startHour = parseInt(startStr.split(':')[0]);
    const endHour = parseInt(endStr.split(':')[0]);

    const threeHoursInMs = 3 * 60 * 60 * 1000;

    for (let h = startHour; h < endHour; h++) {
      for (let m = 0; m < 60; m += 15) {
        const slotDate = new Date(day);
        slotDate.setHours(h, m, 0, 0);
        const slotTime = slotDate.getTime();

        // 1. ELLENŐRZÉS: Múltbéli időpont? (Mai nap esetén a mostani óra/perc előtt)
        const isPast = slotDate < now;

        // 2. ELLENŐRZÉS: ÜTKÖZÉSVIZSGÁLAT (Oda-vissza 3 óra a foglalásokkal)
        const isConflict = bookedTimestamps.some(bookedTime => {
            return Math.abs(slotTime - bookedTime) < threeHoursInMs;
        });

        // Ha bármelyik igaz, akkor tiltjuk a gombot
        const isBlocked = isPast || isConflict;

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = `${h}:${m === 0 ? '00' : m}`;
        
        if (isBlocked) {
          btn.disabled = true;
          btn.className = "p-2 rounded-xl bg-slate-100 text-slate-300 cursor-not-allowed text-[10px] opacity-50 line-through";
        } else {
          btn.className = "time-btn p-2 rounded-xl bg-white text-slate-700 ring-1 ring-slate-100 text-xs font-bold hover:bg-pink-50 transition-all";
          btn.onclick = () => {
            document.querySelectorAll('.time-btn').forEach(b => {
                b.classList.remove('bg-pink-600', 'text-white', 'ring-pink-600');
                b.classList.add('bg-white', 'text-slate-700', 'ring-1', 'ring-slate-100');
            });
            btn.classList.remove('bg-white', 'text-slate-700', 'ring-1', 'ring-slate-100');
            btn.classList.add('bg-pink-600', 'text-white', 'ring-pink-600');
            
            if (finalInput) {
              const offset = slotDate.getTimezoneOffset() * 60000;
              finalInput.value = new Date(slotDate.getTime() - offset).toISOString().slice(0, 16);
            }
          };
        }
        slotsDiv.appendChild(btn);
      }
    }
  }

  async function start() {
    await fetchBookedSlots();
    // @ts-ignore
    flatpickr("#inline-calendar", {
      inline: true,
      appendTo: document.getElementById('calendar-container'),
      locale: hu,
      minDate: "today",
      dateFormat: "Y-m-d",
      onChange: (selectedDates: Date[]) => {
        if (selectedDates.length > 0) generateSlots(selectedDates[0]);
      }
    });
  }

  start();

  if (form && submitBtn) {
    form.onsubmit = async (e) => {
      e.preventDefault();
      const statusCont = document.getElementById('status-container');
      const btnSpan = submitBtn.querySelector('span');

      submitBtn.disabled = true;
      if (btnSpan) btnSpan.textContent = 'Feldolgozás...';

      try {
        const res = await fetch('/api/book', { method: 'POST', body: new FormData(form) });
        if (statusCont) {
          statusCont.classList.remove('hidden');
          if (res.ok) {
            statusCont.className = "mt-6 p-6 bg-green-50 text-green-700 rounded-3xl border border-green-200";
            statusCont.textContent = "Sikeres foglalás!";
            form.reset();
            selectionArea?.classList.add('hidden');
            await fetchBookedSlots();
          } else {
            const r = await res.json();
            statusCont.className = "mt-6 p-6 bg-red-50 text-red-700 rounded-3xl border border-red-200";
            statusCont.textContent = r.error || "Hiba történt.";
          }
        }
      } catch (err) {
        console.error(err);
      } finally {
        submitBtn.disabled = false;
        if (btnSpan) btnSpan.textContent = 'Időpont véglegesítése';
      }
    };
  }
</script>

<style>
  :global(.flatpickr-calendar) { box-shadow: none !important; border: none !important; width: 100% !important; background: transparent !important; }
  :global(.flatpickr-day.selected) { background: #db2777 !important; border-color: #db2777 !important; border-radius: 12px !important; }
</style>