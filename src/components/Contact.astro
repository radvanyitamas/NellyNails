---
// src/components/Contact.astro
---

<section id="kapcsolat" class="py-24 px-4 bg-white relative">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      
      <div class="space-y-12">
        <div>
          <h2 class="text-4xl font-serif font-bold text-slate-900 mb-6 tracking-tight">Időpontfoglalás</h2>
          <p class="text-slate-600 mb-8 leading-relaxed">
            Válassz egy számodra megfelelő napot, majd kattints az elérhető szabad időpontok egyikére. 
            A választható kezdőpontok 15 percenként érhetőek el, minden munka 3 órát vesz igénybe.
          </p>
          
          <div class="space-y-6">
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 bg-pink-100 rounded-2xl flex items-center justify-center text-pink-600 shadow-sm">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <a href="tel:+36304330624" class="text-lg font-semibold text-slate-800 hover:text-pink-600 transition-colors tracking-tight">+36 30 433 0624</a>
            </div>
            <div class="flex items-center space-x-4">
               <div class="w-12 h-12 bg-pink-100 rounded-2xl flex items-center justify-center text-pink-600 shadow-sm">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <p class="text-lg font-semibold text-slate-800 tracking-tight">6721 Szeged, Hullám utca 3.</p>
            </div>
          </div>
        </div>

        <div class="bg-slate-50 p-8 rounded-[2.5rem] border border-slate-100 shadow-sm">
          <h3 class="text-xl font-bold mb-6 text-slate-800 flex items-center">
            <span class="w-2 h-2 bg-pink-500 rounded-full mr-3"></span> Nyitvatartás
          </h3>
          <div class="space-y-4">
            <div class="flex justify-between border-b border-slate-200 pb-3 italic">
              <span class="text-slate-500 font-light text-sm">Hétfő - Péntek</span>
              <span class="text-slate-900 font-bold">15:00 - 20:00</span>
            </div>
            <div class="flex justify-between border-b border-slate-200 pb-3 italic">
              <span class="text-slate-500 font-light text-sm">Szombat - Vasárnap</span>
              <span class="text-slate-900 font-bold">10:00 - 15:00</span>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-slate-50 p-8 md:p-12 rounded-[2.5rem] border border-pink-100 shadow-xl relative overflow-hidden">
        <form id="booking-form" class="space-y-6 relative z-10">
          <div class="space-y-4">
            <input type="text" name="name" required placeholder="Teljes név" class="w-full p-4 rounded-2xl bg-white border-none ring-1 ring-slate-200 focus:ring-2 focus:ring-pink-500 outline-none transition-all" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <input type="email" name="email" required placeholder="E-mail" class="w-full p-4 rounded-2xl bg-white border-none ring-1 ring-slate-200 focus:ring-2 focus:ring-pink-500 outline-none transition-all" />
              <input type="tel" name="phone" required placeholder="Telefon" class="w-full p-4 rounded-2xl bg-white border-none ring-1 ring-slate-200 focus:ring-2 focus:ring-pink-500 outline-none transition-all" />
            </div>
          </div>

          <div class="space-y-4">
            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">1. Válaszd ki a napot</label>
            <input type="text" id="inline-calendar" required class="hidden" />
            <div id="calendar-container" class="rounded-3xl overflow-hidden shadow-inner ring-1 ring-slate-200 bg-white"></div>
          </div>

          <div id="time-selection" class="space-y-4 hidden animate-in fade-in slide-in-from-top-4">
            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">2. Szabad időpontok (15 perc)</label>
            <div id="time-slots" class="grid grid-cols-4 gap-2">
              </div>
            <input type="hidden" name="date" id="final-date-input" required />
          </div>
          
          <button type="submit" id="submit-btn" class="w-full py-5 bg-pink-600 text-white font-bold rounded-2xl hover:bg-pink-700 disabled:bg-slate-300 disabled:cursor-not-allowed transition-all flex items-center justify-center shadow-lg active:scale-95">
            <span>Időpont véglegesítése</span>
          </button>
        </form>

        <div id="status-container" class="mt-6 hidden p-6 rounded-3xl text-center font-bold"></div>
      </div>
    </div>

    <div class="mt-16 rounded-[2.5rem] overflow-hidden shadow-2xl h-[400px] border-8 border-white ring-1 ring-slate-100">
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2729.93245459392!2d20.147285676839345!3d46.26145618058229!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x474488667a4805c3%3A0xb3638787836b000!2sSzeged%2C%20Hull%C3%A1m%20u.%203%2C%206721!5e0!3m2!1shu!2shu!4v1715084000000!5m2!1shu!2shu" class="w-full h-full border-0" allowfullscreen="" loading="lazy"></iframe>
    </div>
  </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://npmcdn.com/flatpickr/dist/l10n/hu.js"></script>

<script>
  let bookedSlots: Date[] = [];
  const timeSlotsContainer = document.getElementById('time-slots');
  const timeSelection = document.getElementById('time-selection');
  const finalDateInput = document.getElementById('final-date-input') as HTMLInputElement;

  async function initBookingSystem() {
    try {
      const resp = await fetch('/api/get-slots');
      bookedSlots = (await resp.json()).map((d: string) => new Date(d));

      // @ts-ignore
      flatpickr("#inline-calendar", {
        inline: true,
        appendTo: document.getElementById('calendar-container'),
        locale: "hu",
        minDate: "today",
        dateFormat: "Y-m-d",
        onChange: function(selectedDates) {
          if (selectedDates.length > 0) {
            generateTimeSlots(selectedDates[0]);
          }
        }
      });
    } catch (err) {
      console.error("Hiba a naptár betöltésekor", err);
    }
  }

  function generateTimeSlots(selectedDay: Date) {
    if (!timeSlotsContainer || !timeSelection) return;
    
    timeSlotsContainer.innerHTML = ''; 
    timeSelection.classList.remove('hidden');
    
    const day = selectedDay.getDay();
    const isWeekend = (day === 0 || day === 6);
    const startHour = isWeekend ? 10 : 15;
    const endHour = isWeekend ? 15 : 20;

    for (let hour = startHour; hour < endHour; hour++) {
      for (let min = 0; min < 60; min += 15) {
        if (hour === endHour - 1 && min > 45) continue;

        const currentSlot = new Date(selectedDay);
        currentSlot.setHours(hour, min, 0, 0);

        const button = document.createElement('button');
        button.type = 'button';
        const formattedTime = `${hour}:${min === 0 ? '00' : min}`;
        button.textContent = formattedTime;
        
        const isBooked = bookedSlots.some(booked => 
          Math.abs(booked.getTime() - currentSlot.getTime()) < (3 * 60 * 60 * 1000)
        );

        if (isBooked) {
          button.disabled = true;
          button.className = "p-2 rounded-xl bg-slate-100 text-slate-300 cursor-not-allowed text-[10px] line-through";
        } else {
          // --- ALAP STÍLUS (INAKTÍV) ---
          button.className = "time-btn p-2 rounded-xl bg-white text-slate-700 ring-1 ring-slate-200 hover:bg-pink-50 hover:text-pink-600 transition-all text-xs font-bold shadow-sm";
          
          button.onclick = () => {
            // 1. Összes gomb visszaállítása az alapállapotba
            document.querySelectorAll('.time-btn').forEach(b => {
              b.classList.remove('bg-pink-600', 'text-white', 'ring-pink-600', 'shadow-md');
              b.classList.add('bg-white', 'text-slate-700', 'ring-1', 'ring-slate-200');
            });

            // 2. Az aktuálisan kattintott gomb beállítása (AKTÍV)
            button.classList.remove('bg-white', 'text-slate-700', 'ring-1', 'ring-slate-200');
            button.classList.add('bg-pink-600', 'text-white', 'ring-pink-600', 'shadow-md');
            
            // 3. Érték rögzítése a rejtett inputba
            const offset = currentSlot.getTimezoneOffset() * 60000;
            const localISOTime = new Date(currentSlot.getTime() - offset).toISOString().slice(0, 16);
            finalDateInput.value = localISOTime;
          };
        }
        timeSlotsContainer.appendChild(button);
      }
    }
  }

  initBookingSystem();

  const form = document.getElementById('booking-form') as HTMLFormElement;
  const statusContainer = document.getElementById('status-container') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!finalDateInput.value) {
      alert("Kérlek, válassz egy időpontot is a gombok közül!");
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = 'Feldolgozás...';

    const response = await fetch('/api/book', { method: 'POST', body: new FormData(form) });
    const result = await response.json();

    statusContainer.classList.remove('hidden');
    if (response.ok) {
      statusContainer.className = "mt-6 p-6 bg-green-50 text-green-700 border border-green-200 rounded-3xl";
      statusContainer.textContent = "Siker! Kérlek, keresd a megerősítő e-mailt a fiókodban.";
      form.reset();
      timeSelection?.classList.add('hidden');
      initBookingSystem();
    } else {
      statusContainer.className = "mt-6 p-6 bg-red-50 text-red-700 border border-red-200 rounded-3xl";
      statusContainer.textContent = result.error || "Hiba történt.";
    }
    submitBtn.disabled = false;
    submitBtn.textContent = "Időpont véglegesítése";
  });
</script>

<style>
  :global(.flatpickr-calendar) {
    box-shadow: none !important;
    border: none !important;
    width: 100% !important;
    background: transparent !important;
  }
  :global(.flatpickr-day.selected) {
    background: #db2777 !important;
    border-color: #db2777 !important;
  }
  /* Megszüntetjük a fókuszt követő kék keretet */
  button:focus {
    outline: none;
  }
</style>