---
// src/components/Contact.astro
import { supabase } from '../lib/supabase';

// ==========================================
// 1. ADATBÁZIS LEKÉRDEZÉSEK (Szerver oldal)
// ==========================================
const { data: settingsData } = await supabase.from('site_settings').select('*');
const { data: openingHours } = await supabase.from('opening_hours').select('*').order('day_id');

// Lekérjük a rendkívüli lezárt napokat is a dátummal és a hozzájuk tartozó indokkal (reason) együtt
const { data: closedDatesData } = await supabase.from('closed_dates').select('closed_date, reason');

// Kinyerjük a kapcsolati adatokat
const email = settingsData?.find(s => s.key === 'contact_email')?.value || "nellirad@gmail.com";
const phone = settingsData?.find(s => s.key === 'contact_phone')?.value || "+36 30 732 8747";
const address = settingsData?.find(s => s.key === 'contact_address')?.value || "6728 Szeged, Példa utca 1.";

const hoursMap = openingHours || [];
const extraClosedDates = closedDatesData || [];
---

<section id="kapcsolat" class="py-24 px-4 bg-white relative">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      
      <!-- BAL OLDAL: Kapcsolati kártyák és fix nyitvatartási táblázat -->
      <div class="space-y-12">
        <div>
          <h2 class="text-4xl font-serif font-bold text-slate-900 mb-6 tracking-tight">Kapcsolat</h2>
          <p class="text-slate-600 mb-10 leading-relaxed italic">
            Kérdésed van vagy időpontot foglalnál? Keress bizalommal az alábbi elérhetőségeken!
          </p>
          
          <div class="space-y-8">
            <!-- Telefon -->
            <div class="flex items-center space-x-5 group">
              <div class="w-14 h-14 bg-pink-100 rounded-2xl flex items-center justify-center text-pink-600 group-hover:bg-pink-600 group-hover:text-white transition-all duration-300 shadow-sm">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-[0.2em] mb-1">Hívj bátran</p>
                <a href={`tel:${phone.replace(/\s/g, '')}`} class="text-xl font-bold text-slate-800 hover:text-pink-600 transition-colors tracking-tight">{phone}</a>
              </div>
            </div>

            <!-- E-mail -->
            <div class="flex items-center space-x-5 group">
              <div class="w-14 h-14 bg-pink-100 rounded-2xl flex items-center justify-center text-pink-600 group-hover:bg-pink-600 group-hover:text-white transition-all duration-300 shadow-sm">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-[0.2em] mb-1">Írj nekem</p>
                <a href={`mailto:${email}`} class="text-lg font-semibold text-slate-800 hover:text-pink-600 transition-colors">{email}</a>
              </div>
            </div>

            <!-- Helyszín -->
            <div class="flex items-center space-x-5 group">
               <div class="w-14 h-14 bg-pink-100 rounded-2xl flex items-center justify-center text-pink-600 group-hover:bg-pink-600 group-hover:text-white transition-all duration-300 shadow-sm">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-[0.2em] mb-1">Helyszín</p>
                <p class="text-lg font-semibold text-slate-800">{address}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Heti fix nyitvatartás doboz -->
        <div class="bg-slate-50 p-8 rounded-[2.5rem] border border-slate-100 shadow-sm">
          <h3 class="text-xl font-bold mb-6 text-slate-800 flex items-center">
            <span class="w-2 h-2 bg-pink-500 rounded-full mr-3"></span> Nyitvatartás
          </h3>
          <div class="space-y-3">
            {hoursMap.map((day) => (
              <div class="flex justify-between border-b border-slate-200 pb-2 text-sm">
                <span class={day.is_closed ? "text-slate-400" : "text-slate-600"}>{day.day_name}</span>
                <span class={day.is_closed ? "text-red-400 font-medium" : "text-slate-900 font-bold"}>
                  {day.is_closed ? "Zárva" : `${day.open_time} - ${day.close_time}`}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- JOBB OLDAL: Időpontfoglaló űrlap és interaktív naptár -->
      <div class="bg-slate-50 p-8 md:p-12 rounded-[2.5rem] border border-pink-100 shadow-xl relative overflow-hidden">
        
        <form id="booking-form" class="space-y-6" data-hours={JSON.stringify(hoursMap)} data-closed={JSON.stringify(extraClosedDates)}>
          
          <div class="space-y-4">
            <input type="text" name="name" required placeholder="Teljes név" class="w-full p-4 rounded-2xl bg-white border-none ring-1 ring-slate-200 focus:ring-2 focus:ring-pink-500 outline-none transition-all shadow-sm" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <input type="email" name="email" required placeholder="E-mail" class="w-full p-4 rounded-2xl bg-white border-none ring-1 ring-slate-200 focus:ring-2 focus:ring-pink-500 transition-all shadow-sm" />
              <input type="tel" name="phone" required placeholder="Telefon" class="w-full p-4 rounded-2xl bg-white border-none ring-1 ring-slate-200 focus:ring-2 focus:ring-pink-500 transition-all shadow-sm" />
            </div>
          </div>

          <!-- Naptár konténer -->
          <div class="space-y-4">
            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">1. Nap kiválasztása</label>
            <div id="calendar-container" class="rounded-3xl overflow-hidden shadow-inner ring-1 ring-slate-200 bg-white p-2 min-h-75">
                <input type="text" id="inline-calendar" required class="hidden" />
            </div>
          </div>

          <!-- Szabad órák (gombok) területe -->
          <div id="time-selection" class="space-y-4 hidden">
            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">2. Szabad időpontok</label>
            
            <div id="time-slots" class="grid grid-cols-4 gap-2"></div>
            
            <input type="hidden" name="date" id="final-date-input" required />
          </div>
          
          <button type="submit" id="submit-btn" class="w-full py-5 bg-pink-600 text-white font-bold rounded-2xl hover:bg-pink-700 hover:shadow-2xl active:scale-95 transition-all flex items-center justify-center disabled:bg-slate-300 shadow-lg shadow-pink-100">
            <span>Időpont véglegesítése</span>
          </button>
        </form>
        
        <div id="status-container" class="mt-6 hidden p-6 rounded-3xl text-center font-bold border"></div>
      </div>
    </div>
  </div>
</section>

<!-- Flatpickr naptár külső függőségei -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script is:inline src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script>
  const hu = {
    weekdays: { shorthand: ["V", "H", "K", "Sz", "Cs", "P", "Sz"], longhand: ["Vasárnap", "Hétfő", "Kedd", "Szerda", "Csütörtök", "Péntek", "Szombat"] },
    months: { shorthand: ["Jan", "Feb", "Már", "Ápr", "Máj", "Jún", "Júl", "Aug", "Szep", "Okt", "Nov", "Dec"], longhand: ["Január", "Február", "Március", "Április", "Május", "Június", "Július", "Augusztus", "Szeptember", "Október", "November", "December"] },
    firstDayOfWeek: 1, ordinal: () => "."
  };

  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const slotsDiv = document.getElementById('time-slots');
  const selectionArea = document.getElementById('time-selection');
  const finalInput = document.getElementById('final-date-input') as HTMLInputElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  const hoursArray = JSON.parse(form?.dataset.hours || '[]');
  const closedDatesArray = JSON.parse(form?.dataset.closed || '[]'); 

  let bookedTimestamps: number[] = [];

  // Foglalt időpontok lekérése a szerverről
  async function fetchBookedSlots() {
    try {
      const resp = await fetch('/api/get-slots');
      if (resp.ok) {
        const data = await resp.json();
        bookedTimestamps = data.map((d: string) => new Date(d).getTime());
      }
    } catch (e) { 
        console.error("Hiba a foglalt időpontok lekérésekor:", e); 
    }
  }

  // Szabad időpont (Óra/Perc) gombok generálása és kattintások kezelése
  function generateSlots(day: Date) {
    if (!slotsDiv || !selectionArea) return;
    
    slotsDiv.innerHTML = '';
    
    // JAVÍTÁS: Időzóna-független, pontos helyi dátum kinyerése (megakadályozza a napok elcsúszását)
    const year = day.getFullYear();
    const month = String(day.getMonth() + 1).padStart(2, '0');
    const date = String(day.getDate()).padStart(2, '0');
    const selectedISODate = `${year}-${month}-${date}`;
    
    // Megkeressük, van-e rendkívüli zárvatartás erre a konkrét napra
    const customClosedInfo = closedDatesArray.find((d: any) => d.closed_date === selectedISODate);
    
    // BÁRMILYEN ESZKÖZÖN (Mobil/PC) is kattintanak rá, kiírjuk az okot!
    if (customClosedInfo) {
        const reasonText = customClosedInfo.reason ? `: ${customClosedInfo.reason}` : '';
        slotsDiv.innerHTML = `<p class="col-span-4 text-center text-red-500 py-6 bg-red-50 rounded-2xl border border-red-100 italic text-sm font-semibold shadow-inner">Ezen a napon zárva tartok${reasonText}.</p>`;
        selectionArea.classList.remove('hidden');
        return;
    }

    const jsDay = day.getDay();
    const dbDayId = jsDay === 0 ? 7 : jsDay;
    
    const dbConfig = hoursArray.find((d: any) => d.day_id === dbDayId);
    const dayConfig = dbConfig || { is_closed: false, open_time: '08:00:00', close_time: '17:00:00' };

    if (dayConfig.is_closed) {
        slotsDiv.innerHTML = '<p class="col-span-4 text-center text-slate-400 py-6 bg-slate-50 rounded-2xl italic text-sm">Ezen a napon zárva tartok.</p>';
        selectionArea.classList.remove('hidden');
        return;
    }

    selectionArea.classList.remove('hidden');
    const now = new Date();

    const startHour = parseInt(dayConfig.open_time.split(':')[0], 10);
    const endHour = parseInt(dayConfig.close_time.split(':')[0], 10);
    
    const threeHoursInMs = 3 * 60 * 60 * 1000;
    let hasAvailableSlot = false;

    for (let h = startHour; h < endHour; h++) {
      for (let m = 0; m < 60; m += 30) { 
        
        const slotDate = new Date(day);
        slotDate.setHours(h, m, 0, 0);
        const slotTime = slotDate.getTime();

        const isPast = slotDate < now;
        const isConflict = bookedTimestamps.some(bookedTime => Math.abs(slotTime - bookedTime) < threeHoursInMs);
        const isBlocked = isPast || isConflict;

        const btn = document.createElement('button');
        btn.type = 'button';
        
        const formattedHour = h.toString().padStart(2, '0');
        const formattedMin = m === 0 ? '00' : m.toString();
        btn.textContent = `${formattedHour}:${formattedMin}`;
        
        if (isBlocked) {
          btn.disabled = true;
          btn.className = "p-2 rounded-xl bg-slate-100 text-slate-300 cursor-not-allowed text-[10px] opacity-50 line-through";
        } else {
          hasAvailableSlot = true;
          btn.className = "time-btn p-2 rounded-xl bg-white text-slate-700 ring-1 ring-slate-100 text-xs font-bold hover:bg-pink-50 transition-all";
          
          btn.onclick = () => {
            document.querySelectorAll('.time-btn').forEach(b => {
                b.classList.remove('bg-pink-600', 'text-white', 'ring-pink-600');
                b.classList.add('bg-white', 'text-slate-700', 'ring-1', 'ring-slate-100');
            });
            btn.classList.remove('bg-white', 'text-slate-700', 'ring-1', 'ring-slate-100');
            btn.classList.add('bg-pink-600', 'text-white', 'ring-pink-600');
            
            if (finalInput) {
              const offset = slotDate.getTimezoneOffset() * 60000;
              finalInput.value = new Date(slotDate.getTime() - offset).toISOString().slice(0, 16);
            }
          };
        }
        
        slotsDiv.appendChild(btn);
      }
    }

    if (!hasAvailableSlot) {
        slotsDiv.innerHTML = '<p class="col-span-4 text-center text-slate-400 py-6 bg-slate-50 rounded-2xl italic text-sm">Erre a napra már minden időpont betelt.</p>';
    }
  }

  // RENDSZER INDÍTÁSA
  async function start() {
    await fetchBookedSlots();
    
    const today = new Date();
    const minAllowedDate = new Date(today);
    minAllowedDate.setDate(today.getDate() + 2); // Ma és holnap letiltva

    // @ts-ignore
    flatpickr("#inline-calendar", {
      inline: true,
      appendTo: document.getElementById('calendar-container'),
      locale: hu,
      minDate: minAllowedDate,
      dateFormat: "Y-m-d",
      
      // JAVÍTÁS: Levettük a natív 'disable' tulajdonságot. Helyette a napokat kattinthatóan hagyjuk,
      // hogy a vendég rákattinthasson, és megjelenjen neki a magyarázó szöveg alul.
      // Ehelyett a megjelenést manipuláljuk az onDayCreate-ben!
      
      onDayCreate: (dObj, dStr, fp, dayElem) => {
        // Helyi időzónás, pontos dátum kinyerése a napok formázásához
        const localYear = dayElem.dateObj.getFullYear();
        const localMonth = String(dayElem.dateObj.getMonth() + 1).padStart(2, '0');
        const localDay = String(dayElem.dateObj.getDate()).padStart(2, '0');
        const dateISO = `${localYear}-${localMonth}-${localDay}`;

        const match = closedDatesArray.find((d: any) => d.closed_date === dateISO);
        
        if (match) {
          // Ha ez a nap zárva van, adunk neki egy egyedi CSS classt (Lásd: style rész a fájl alján)
          // Így úgy néz ki, mintha inaktív lenne, de közben RÁ LEHET KATTINTANI!
          dayElem.classList.add('custom-closed-day');
        }
      },
      onChange: (selectedDates: Date[]) => {
        if (selectedDates.length > 0) generateSlots(selectedDates[0]);
      }
    });
  }

  start();

  // FORM BEKÜLDÉSE (FOGLALÁS)
  if (form && submitBtn) {
    form.onsubmit = async (e) => {
      e.preventDefault();
      
      const statusCont = document.getElementById('status-container');
      const btnSpan = submitBtn.querySelector('span');

      // Véglegesítés ellenőrzése
      if (!finalInput?.value) {
          alert("Kérlek, válassz ki egy szabad időpontot a naptárban!");
          return;
      }

      submitBtn.disabled = true;
      if (btnSpan) btnSpan.textContent = 'Feldolgozás...';

      try {
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        const res = await fetch('/api/book', { 
            method: 'POST', 
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data) 
        });

        if (statusCont) {
          statusCont.classList.remove('hidden');
          if (res.ok) {
            statusCont.className = "mt-6 p-6 bg-green-50 text-green-700 rounded-3xl border border-green-200";
            statusCont.textContent = "Sikeres foglalás! E-mailben küldtük a visszaigazoló linket.";
            form.reset();
            selectionArea?.classList.add('hidden');
            await fetchBookedSlots();
          } else {
            const r = await res.json();
            statusCont.className = "mt-6 p-6 bg-red-50 text-red-700 rounded-3xl border border-red-200";
            statusCont.textContent = r.error || "Hiba történt a foglalás során.";
          }
        }
      } catch (err) {
        console.error("Váratlan hiba:", err);
      } finally {
        submitBtn.disabled = false;
        if (btnSpan) btnSpan.textContent = 'Időpont véglegesítése';
      }
    };
  }
</script>

<style>
  /* A naptár dizájnjának finomhangolása */
  :global(.flatpickr-calendar) { box-shadow: none !important; border: none !important; width: 100% !important; background: transparent !important; }
  
  /* A kiválasztott (kattintott) nap stílusa */
  :global(.flatpickr-day.selected) { background: #db2777 !important; border-color: #db2777 !important; border-radius: 12px !important; color: white !important;}
  
  /* MOBILBARÁT MEGOLDÁS: A lezárt napok áthúzottnak, pirosasnak és halványnak látszanak, 
     de nincsenek letiltva, így ha az ügyfél rányom, meglátja a piros figyelmeztetést! */
  :global(.custom-closed-day) { 
      color: #ef4444 !important; /* Piros szöveg */
      text-decoration: line-through !important; /* Áthúzott */
      background-color: #fef2f2 !important; /* Halvány piros háttér */
      border-radius: 12px !important;
  }
  
  /* Ha a vendég mégis rákattint egy lezárt napra (aktívvá teszi), akkor feltűnőbb piros lesz */
  :global(.custom-closed-day.selected) {
      background-color: #ef4444 !important; 
      color: white !important;
      border-color: #ef4444 !important;
      text-decoration: line-through !important;
  }
</style>