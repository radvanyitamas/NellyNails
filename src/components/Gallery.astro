---
// src/components/Gallery.astro
import { supabase } from '../lib/supabase';

// 1. Képek lekérése az adatbázisból (legfrissebbek elöl)
const { data: works = [] } = await supabase
  .from('gallery')
  .select('*')
  .order('created_at', { ascending: false });

// 2. Egyedi kategóriák kigyűjtése a gombokhoz a feltöltött képek alapján
const rawCategories = [...new Set(works.map(work => work.category))];
const categories = ["Összes", ...rawCategories];
---

<section id="munkak" class="py-24 px-4 bg-white relative">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-5xl font-serif font-bold text-slate-900 mb-6 tracking-tight">Műköröm és Gél Lakk Referenciák</h2>
      
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        {categories.map((cat) => (
          <button 
            data-filter={cat}
            aria-label={`${cat} kategória szűrése`}
            class:list={[
              "filter-btn px-6 py-2 rounded-full border text-sm font-semibold transition-all duration-300 active:scale-95",
              cat === "Összes" 
                ? "bg-pink-600 text-white shadow-lg border-pink-600" 
                : "bg-white text-slate-700 border-pink-100 hover:bg-pink-50 hover:text-pink-600"
            ]}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {works.map((work, index) => {
        const isInitial = index < 3;
        return (
          <div 
            class={`gallery-item group relative overflow-hidden rounded-[2.5rem] bg-slate-100 cursor-pointer aspect-4/5 ${!isInitial ? 'hidden-gallery-item' : ''}`}
            style={!isInitial ? 'display: none;' : 'display: block;'}
            data-category={work.category}
            data-title={work.title}
          >
            <img 
              src={isInitial ? work.src : ""} 
              data-src={work.src}
              alt={`${work.title} - ${work.category} | Nails by Nelly Szeged`} 
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-linear-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-8">
              <span class="text-pink-400 text-xs font-bold uppercase tracking-widest mb-1">{work.category}</span>
              <h3 class="text-white text-xl font-serif">{work.title}</h3>
            </div>
          </div>
        );
      })}
    </div>

    {works.length > 3 && (
      <div class="text-center mt-12" id="load-more-container">
        <button 
          id="load-more-gallery-btn"
          class="px-8 py-4 bg-pink-600 text-white font-bold rounded-full shadow-lg hover:bg-pink-700 transition-all active:scale-95"
        >
          Teljes galéria megtekintése
        </button>
      </div>
    )}
  </div>

  <div id="lightbox" class="fixed inset-0 z-100 flex items-center justify-center bg-slate-950/95 backdrop-blur-xl opacity-0 pointer-events-none transition-opacity duration-500">
    <button id="close-lightbox" aria-label="Galéria bezárása" class="absolute top-8 right-8 text-white/50 hover:text-white transition-colors z-110">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <button id="prev-btn" aria-label="Előző kép mutatása" class="absolute left-4 md:left-8 text-white/30 hover:text-white transition-all p-4 z-110">
      <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button id="next-btn" aria-label="Következő kép mutatása" class="absolute right-4 md:right-8 text-white/30 hover:text-white transition-all p-4 z-110">
      <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 5l7 7-7 7"/></svg>
    </button>

    <div class="max-w-[90vw] max-h-[85vh] relative flex flex-col items-center">
      <img id="lightbox-img" src="" alt="" loading="lazy" decoding="async" class="max-w-full max-h-[70vh] rounded-3xl shadow-2xl object-contain ring-1 ring-white/10" />
      <div class="mt-8 text-center px-4">
        <h3 id="lightbox-title" class="text-white text-2xl md:text-3xl font-serif font-light tracking-wide"></h3>
        <p id="lightbox-cat" class="text-pink-400 text-xs font-bold uppercase tracking-[0.3em] mt-3"></p>
      </div>
    </div>
  </div>
</section>

<script>
  function initGallery() {
    const filterButtons = document.querySelectorAll('.filter-btn') as NodeListOf<HTMLButtonElement>;
    const loadMoreBtn = document.getElementById('load-more-gallery-btn') as HTMLButtonElement;
    const loadMoreContainer = document.getElementById('load-more-container') as HTMLElement;
    const lightbox = document.getElementById('lightbox') as HTMLElement;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxTitle = document.getElementById('lightbox-title') as HTMLElement;
    const lightboxCat = document.getElementById('lightbox-cat') as HTMLElement;
    const closeBtn = document.getElementById('close-lightbox') as HTMLButtonElement;
    const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;

    if (!lightbox) return;

    let currentFilter = "Összes";
    let isExpanded = false;

    // Összes kép betöltése és megjelenítése a rejtett elemeknél
    const expandAllImages = () => {
      isExpanded = true;
      if (loadMoreContainer) loadMoreContainer.style.display = 'none';
      
      document.querySelectorAll('.hidden-gallery-item').forEach(el => {
        el.classList.remove('hidden-gallery-item');
        const img = el.querySelector('img');
        if (img && !img.getAttribute('src') && img.dataset.src) {
          img.src = img.dataset.src;
        }
      });
    };

    const updateVisibility = () => {
      const galleryItems = document.querySelectorAll('.gallery-item') as NodeListOf<HTMLElement>;
      
      galleryItems.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        const matchesFilter = (currentFilter === "Összes" || itemCat === currentFilter);
        const isHiddenClass = item.classList.contains('hidden-gallery-item');

        if (matchesFilter) {
          if (isExpanded || !isHiddenClass) {
            item.style.display = "block";
            
            const img = item.querySelector('img');
            if (img && !img.getAttribute('src') && img.dataset.src) {
              img.src = img.dataset.src;
            }
          } else {
            item.style.display = "none";
          }
        } else {
          item.style.display = "none";
        }
      });
    };

    loadMoreBtn?.addEventListener('click', () => {
      expandAllImages();
      updateVisibility();
    });

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = btn.getAttribute('data-filter') || "Összes";
        
        // Ha kategóriát vált, automatikusan betöltjük az összes többi képet is
        if (!isExpanded) {
          expandAllImages();
        }
        
        filterButtons.forEach(b => {
          b.classList.remove('bg-pink-600', 'text-white', 'shadow-lg', 'border-pink-600');
          b.classList.add('bg-white', 'text-slate-700', 'border-pink-100');
        });
        btn.classList.add('bg-pink-600', 'text-white', 'shadow-lg', 'border-pink-600');
        btn.classList.remove('bg-white', 'text-slate-700', 'border-pink-100');

        updateVisibility();
      });
    });

    const getVisibleItems = (): HTMLElement[] => {
      return Array.from(document.querySelectorAll('.gallery-item') as NodeListOf<HTMLElement>).filter(
        item => item.style.display !== "none"
      );
    };

    let currentIndex = 0;

    const updateLightbox = (index: number) => {
      const visibleItems = getVisibleItems();
      const item = visibleItems[index];
      if (!item) return;

      const img = item.querySelector('img');
      const src = img?.getAttribute('src') || img?.getAttribute('data-src') || '';
      const title = item.getAttribute('data-title') || '';
      const cat = item.getAttribute('data-category') || '';

      lightboxImg.src = src;
      lightboxImg.alt = `${title} - ${cat} | Nails by Nelly Szeged`;
      
      lightboxTitle.textContent = title;
      lightboxCat.textContent = cat;
      currentIndex = index;
    };

    document.getElementById('gallery-grid')?.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest('.gallery-item') as HTMLElement;
      if (!item) return;

      const visibleItems = getVisibleItems();
      const index = visibleItems.indexOf(item);
      if (index !== -1) {
        updateLightbox(index);
        lightbox.classList.remove('opacity-0', 'pointer-events-none');
      }
    });

    const closeLightbox = () => {
      lightbox.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => { 
        lightboxImg.src = ""; 
        lightboxImg.alt = ""; 
      }, 300);
    };
    
    closeBtn?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => { if(e.target === lightbox) closeLightbox(); });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const visibleItems = getVisibleItems();
      if (visibleItems.length === 0) return;
      currentIndex = (currentIndex + 1) % visibleItems.length;
      updateLightbox(currentIndex);
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const visibleItems = getVisibleItems();
      if (visibleItems.length === 0) return;
      currentIndex = (currentIndex - 1 + visibleItems.length) % visibleItems.length;
      updateLightbox(currentIndex);
    });

    window.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('opacity-0')) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowRight") nextBtn?.click();
      if (e.key === "ArrowLeft") prevBtn?.click();
    });
  }

  document.addEventListener('DOMContentLoaded', initGallery);
  document.addEventListener('astro:page-load', initGallery);
</script>

<style>
  .gallery-item {
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
