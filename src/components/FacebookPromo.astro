---
// src/components/FacebookPromo.astro
const fbLink = "https://www.facebook.com/profile.php?id=61590782765261";
---

<section class="py-12 px-4 bg-white relative">
  <div class="max-w-5xl mx-auto">
    <div class="bg-gradient-to-r from-pink-50 to-white border border-pink-100 rounded-[2.5rem] p-8 md:p-10 shadow-lg shadow-pink-50 flex flex-col lg:flex-row items-center justify-between gap-10 relative overflow-hidden group">
      
      <svg class="absolute -right-10 -bottom-10 w-64 h-64 text-[#1877F2] opacity-5 transition-transform duration-500 group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
      </svg>

      <div class="flex flex-col md:flex-row items-center md:items-start text-center md:text-left gap-6 relative z-10 flex-1">
        <div class="w-20 h-20 bg-[#1877F2] rounded-3xl flex-shrink-0 flex items-center justify-center shadow-md shadow-blue-200">
          <svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </div>
        
        <div class="mt-2">
          <h3 class="text-3xl font-serif font-bold text-slate-900 mb-2 tracking-tight">Kövess Facebookon is!</h3>
          <p class="text-slate-600 text-lg max-w-lg leading-relaxed">
            Nézd meg a legújabb elkészült körmöket, olvasd el a friss híreket, és értesülj elsőként a felszabadult időpontokról!
          </p>
        </div>
      </div>

      <div class="relative z-10 flex flex-col sm:flex-row items-center gap-6 shrink-0">
        
        <a href={fbLink} target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-[#1877F2] text-white text-lg font-bold rounded-2xl hover:bg-[#166fe5] hover:shadow-xl hover:-translate-y-1 active:scale-95 transition-all duration-300 flex items-center gap-3">
          <span>Ugrás az oldalra</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>

        <div class="hidden sm:block w-px h-16 bg-pink-200 rounded-full"></div>

        <div class="flex flex-col items-center">
          <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-3">Vagy olvasd be</p>
          <div class="bg-white p-2.5 rounded-2xl shadow-sm border border-pink-100 group-hover:border-pink-300 transition-colors">
            <img src="/fb-qr.png" alt="Facebook QR Kód" class="w-20 h-20 object-contain rounded-xl" />
          </div>
        </div>

      </div>
    </div>
  </div>
</section>