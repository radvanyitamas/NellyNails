---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Időpont lemondva">
  <!-- 'p-4' biztosítja, hogy mobilon ne érjen hozzá a széléhez a tartalom -->
  <div class="min-h-screen flex items-center justify-center bg-[#fdf2f8] p-4">
    <!-- 'p-8 md:p-12' és 'rounded-[2rem] md:rounded-[3rem]' a mobilbarát méretezéshez -->
    <div class="max-w-md w-full bg-white p-8 md:p-12 rounded-[2rem] md:rounded-[3rem] shadow-2xl border border-pink-100 text-center animate-fade-in">
      <div class="text-5xl mb-6">✨</div>
      
      <h1 class="text-3xl font-serif font-bold text-slate-900 mb-4">Időpont lemondva</h1>
      <p class="text-slate-600 mb-10 font-medium leading-relaxed">
        Az időpontodat sikeresen töröltük a rendszerből. Sajnáljuk, hogy most nem tudsz jönni, de várunk vissza máskor!
      </p>

      <a 
        href="/" 
        class="block w-full py-5 bg-pink-600 text-white font-bold rounded-2xl shadow-lg shadow-pink-200 hover:bg-pink-700 transition-all active:scale-95 text-sm uppercase tracking-widest"
      >
        Vissza a kezdőoldalra
      </a>
    </div>
  </div>
</Layout>

<style>
  .animate-fade-in {
    animation: fadeIn 0.5s ease-out forwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>