---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: hours } = await supabase.from('opening_hours').select('*').order('day_id');
const { data: settings } = await supabase.from('site_settings').select('*');

const email = settings?.find(s => s.key === 'contact_email')?.value;
const phone = settings?.find(s => s.key === 'contact_phone')?.value;
const address = settings?.find(s => s.key === 'contact_address')?.value;
---

<Layout title="Beállítások | Admin">
  <main class="max-w-4xl mx-auto py-12 md:py-20 px-4">
    <h1 class="text-2xl md:text-3xl font-serif mb-8 md:mb-10 text-center md:text-left">Weboldal Beállítások</h1>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12">
      
      <!-- KAPCSOLATI ADATOK SZEKCIÓ -->
      <section class="bg-white p-6 md:p-8 rounded-3xl border border-stone-200 shadow-sm">
        <h2 class="text-lg md:text-xl font-bold mb-6">Kapcsolati adatok</h2>
        
        <div class="mb-6 p-4 bg-stone-50 rounded-xl text-xs md:text-sm border border-stone-100">
            <p class="font-bold text-stone-700 mb-1">Jelenlegi elérhetőségek:</p>
            <p class="text-stone-600 truncate">📞 {phone}</p>
            <p class="text-stone-600 truncate">✉️ {email}</p>
        </div>

        <form id="settings-form" class="space-y-4">
          <div>
            <label class="block text-xs text-stone-500 mb-1 font-bold uppercase">Email</label>
            <input type="email" name="contact_email" value={email} class="w-full border p-3 rounded-xl text-sm" />
          </div>
          <div>
            <label class="block text-xs text-stone-500 mb-1 font-bold uppercase">Telefonszám</label>
            <input type="text" name="contact_phone" value={phone} class="w-full border p-3 rounded-xl text-sm" />
          </div>
          <div>
            <label class="block text-xs text-stone-500 mb-1 font-bold uppercase">Cím</label>
            <input type="text" name="contact_address" value={address} class="w-full border p-3 rounded-xl text-sm" />
          </div>
          <button type="submit" class="w-full bg-pink-600 text-white py-3 rounded-xl font-bold hover:bg-pink-700 transition-colors active:scale-[0.98]">Mentés</button>
        </form>
      </section>

      <!-- NYITVATARTÁS SZEKCIÓ -->
      <section class="bg-white p-6 md:p-8 rounded-3xl border border-stone-200 shadow-sm">
        <h2 class="text-lg md:text-xl font-bold mb-6">Nyitvatartás</h2>
        <form id="hours-form" class="space-y-2">
          {hours?.map((day) => (
            <div class="flex items-center gap-2 p-2 border-b border-stone-50 overflow-x-auto">
              <span class="w-20 md:w-24 font-medium text-xs md:text-sm flex-shrink-0">{day.day_name}</span>
              
              <div class="flex items-center gap-1">
                <input type="text" name={`open_${day.day_id}`} value={day.open_time} placeholder="08:00" class="w-14 md:w-16 border p-1 rounded-md text-center text-xs md:text-sm" />
                <span class="text-stone-400">-</span>
                <input type="text" name={`close_${day.day_id}`} value={day.close_time} placeholder="17:00" class="w-14 md:w-16 border p-1 rounded-md text-center text-xs md:text-sm" />
              </div>
              
              <label class="flex items-center gap-1 ml-auto cursor-pointer flex-shrink-0">
                <input type="checkbox" name={`closed_${day.day_id}`} checked={day.is_closed} class="w-4 h-4" />
                <span class="text-[10px] md:text-xs text-stone-500">Zárva</span>
              </label>
            </div>
          ))}
          <button type="submit" class="w-full mt-6 bg-stone-800 text-white py-3 rounded-xl font-bold hover:bg-black transition-colors active:scale-[0.98]">Időpontok frissítése</button>
        </form>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  document.getElementById('settings-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);
    
    for (const [key, value] of formData.entries()) {
      await supabase.from('site_settings').upsert({ key, value });
    }
    alert('Kapcsolati adatok sikeresen mentve!');
  });

  document.getElementById('hours-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);

    for (let i = 1; i <= 7; i++) {
        await supabase.from('opening_hours').update({
            open_time: formData.get(`open_${i}`),
            close_time: formData.get(`close_${i}`),
            is_closed: formData.get(`closed_${i}`) === 'on'
        }).eq('day_id', i);
    }
    alert('Nyitvatartás frissítve!');
    window.location.reload();
  });
</script>