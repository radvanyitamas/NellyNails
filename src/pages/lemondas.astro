---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const id = Astro.url.searchParams.get('id');
let booking = null;

if (id) {
  const { data } = await supabase
    .from('bookings')
    .select('*')
    .eq('id', id)
    .single();
  booking = data;
}

if (!booking) return Astro.redirect('/');

const formattedDate = new Date(booking.booking_date).toLocaleString('hu-HU', { 
    year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' 
});
---

<Layout title="Foglalás lemondása">
  <div class="min-h-screen flex items-center justify-center bg-[#fdf2f8] px-6">
    <div class="max-w-md w-full bg-white p-10 md:p-12 rounded-[3.5rem] shadow-2xl border border-pink-100 text-center">
      <div class="text-4xl mb-6">⚠️</div>
      
      <h1 class="text-2xl font-bold text-slate-900 mb-2">Időpont lemondása</h1>
      <p class="text-slate-500 mb-8 italic">Biztosan le szeretnéd mondani a következő időpontot?</p>

      <div class="bg-slate-50 rounded-3xl p-8 mb-8 border border-slate-100 text-left space-y-4">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400 block mb-1">Vendég</span>
          <p class="font-bold text-slate-800 text-lg">{booking.name}</p>
        </div>
        <div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400 block mb-1">Időpont</span>
          <p class="font-bold text-slate-800 text-lg">{formattedDate}</p>
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <button 
          id="cancel-confirm-btn" 
          data-id={id}
          class="w-full py-5 bg-red-500 text-white font-bold rounded-2xl shadow-lg hover:bg-red-600 transition-all active:scale-95"
        >
          IGEN, LEMONDOM
        </button>
        <a href="/" class="w-full py-4 text-slate-400 font-bold hover:text-slate-600 transition-all text-sm">
          Mégsem, megtartom az időpontot
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  const btn = document.getElementById('cancel-confirm-btn');
  btn?.addEventListener('click', async () => {
    const id = btn.getAttribute('data-id');
    btn.innerText = "Törlés...";
    btn.style.opacity = "0.7";
    btn.style.pointerEvents = "none";

    // Meghívjuk a lemondó API-t
    const res = await fetch(`/api/cancel?id=${id}`);
    if (res.ok) {
      window.location.href = '/lemondas-sikeres';
    } else {
      alert("Hiba történt. Lehet, hogy már törölték ezt a foglalást.");
      window.location.href = '/';
    }
  });
</script>