---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const token = Astro.url.searchParams.get('token');

const { data: booking } = await supabase
  .from('bookings')
  .select('*')
  .eq('cancel_token', token)
  .single();

const formattedDate = booking ? new Date(booking.booking_date).toLocaleString('hu-HU', { month: 'long', day: 'numeric' }) : '';
const formattedTime = booking ? new Date(booking.booking_date).toLocaleString('hu-HU', { hour: '2-digit', minute: '2-digit' }) : '';
---

<Layout title="Időpont lemondása">
    <div class="min-h-screen flex flex-col font-sans bg-[#fdf2f8]">
        <!-- Navigáció mobilbarátabbá tétele -->
        <nav class="bg-white/90 backdrop-blur-md sticky top-0 z-50 border-b border-pink-100 px-6 py-4">
            <div class="max-w-7xl mx-auto flex justify-center md:justify-start">
                <a href="/" class="text-2xl md:text-3xl font-serif font-bold text-slate-900 no-underline">Nails<span class="text-pink-600">by</span>Nelly</a>
            </div>
        </nav>

        <div class="flex-1 flex items-center justify-center p-4 md:p-6">
            <!-- A fix p-16-ot lecseréltem p-6 md:p-12-re, a kerekítést szintén igazítottam -->
            <div class="max-w-xl w-full bg-white rounded-[2rem] md:rounded-[4rem] p-6 md:p-16 shadow-2xl shadow-pink-200/30 border border-pink-50 text-center relative overflow-hidden">
                
                {booking ? (
                    <div id="booking-area">
                        <input type="hidden" id="token-data" value={token} />
                        
                        <div class="w-20 h-20 md:w-24 md:h-24 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-6 md:mb-10 text-red-500 shadow-inner">
                            <svg class="w-10 h-10 md:w-12 md:h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </div>
                        
                        <h1 class="text-3xl md:text-5xl font-serif font-bold text-slate-900 mb-4 tracking-tight">Lemondás</h1>
                        <p class="text-slate-500 mb-8 md:mb-12 italic font-medium">Sajnáljuk, ha közbejött valami. Biztosan lemondod?</p>
                        
                        <div class="bg-slate-50 p-6 md:p-12 rounded-[2rem] md:rounded-[3rem] border border-slate-100 mb-8 md:mb-12 shadow-inner">
                            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.3em] mb-4">Lefoglalt időpont</p>
                            <p class="text-slate-700 font-bold text-base md:text-lg mb-2">6721 Szeged, Hullám utca 3.</p>
                            <p class="text-3xl md:text-4xl font-bold text-[#db2777] tracking-tight mb-2">{formattedDate} {formattedTime}</p>
                            <p class="text-slate-400 font-bold">+36 30 732 8747</p>
                        </div>
                        
                        <div class="space-y-4">
                            <button id="cancel-btn" class="w-full py-4 md:py-6 bg-[#db2777] text-white font-bold rounded-[2rem] hover:bg-pink-700 transition-all shadow-xl shadow-pink-200 active:scale-95">Időpont lemondása</button>
                            <a href="/" class="block py-4 text-slate-400 font-bold hover:text-slate-600 transition-all">Mégsem, megtartom az időpontot</a>
                        </div>
                    </div>
                ) : (
                    <div class="py-12 md:py-20 text-center"><p class="text-slate-400 italic text-xl">A foglalás nem található.</p></div>
                )}

                <div id="success-area" class="hidden py-10">
                    <div class="w-24 h-24 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-10 text-green-500 shadow-inner text-4xl">✓</div>
                    <h2 class="text-3xl md:text-5xl font-serif font-bold text-slate-900 mb-6 tracking-tight">Lemondva 🎀</h2>
                    <a href="/" class="inline-block w-full py-4 md:py-6 bg-slate-900 text-white rounded-[2rem] font-bold shadow-xl">Vissza a főoldalra</a>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    const btn = document.getElementById('cancel-btn');
    const token = (document.getElementById('token-data') as HTMLInputElement)?.value;
    
    if (btn && token) {
        btn.addEventListener('click', async () => {
            if (!confirm('Biztosan lemondod?')) return;
            
            btn.innerText = 'Feldolgozás...';
            (btn as HTMLButtonElement).disabled = true;
            
            const res = await fetch('/api/cancel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ token })
            });
            
            if (res.ok) {
                document.getElementById('booking-area')?.classList.add('hidden');
                document.getElementById('success-area')?.classList.remove('hidden');
            } else {
                alert('Hiba történt.');
                btn.innerText = 'Időpont lemondása';
                (btn as HTMLButtonElement).disabled = false;
            }
        });
    }
</script>