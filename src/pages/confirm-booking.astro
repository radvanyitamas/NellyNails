---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const id = Astro.url.searchParams.get('id');
let booking = null;

if (id) {
  const { data } = await supabase
    .from('bookings')
    .select('*')
    .eq('id', id)
    .maybeSingle();
  booking = data;
}

if (!booking) return Astro.redirect('/');

const formattedDate = new Date(booking.booking_date).toLocaleString('hu-HU', { 
    year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' 
});
---

<Layout title="Időpont megerősítése">
  <!-- p-4 mobilon, hogy ne ragadjon a szélhez a doboz -->
  <div class="min-h-screen flex items-center justify-center bg-[#fdf2f8] p-4">
    <!-- p-6 és rounded-[2rem] mobilon, md:p-12 és rounded-[3.5rem] asztalon -->
    <div class="max-w-md w-full bg-white p-6 md:p-12 rounded-[2rem] md:rounded-[3.5rem] shadow-2xl border border-pink-100 text-center animate-fade-in">
      <div class="logo font-serif text-3xl mb-8">Nails<span class="text-pink-600">by</span>Nelly</div>
      
      <h1 class="text-xl md:text-2xl font-bold text-slate-900 mb-2">Időpont ellenőrzése</h1>
      <p class="text-slate-500 mb-8 italic text-sm md:text-base">Kérlek, ellenőrizd az adataidat!</p>

      <div class="bg-pink-50/50 rounded-2xl md:rounded-3xl p-6 md:p-8 mb-8 border border-pink-100 text-left space-y-4">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-pink-400 block mb-1">Vendég neve</span>
          <p class="font-bold text-slate-800 text-base md:text-lg">{booking.name}</p>
        </div>
        <div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-pink-400 block mb-1">Időpont</span>
          <p class="font-bold text-slate-800 text-base md:text-lg leading-tight">{formattedDate}</p>
        </div>
      </div>

      <button 
        id="confirm-booking-btn" 
        data-id={id}
        class="w-full py-4 md:py-5 bg-[#db2777] text-white font-bold rounded-2xl shadow-lg shadow-pink-200 hover:bg-pink-700 transition-all active:scale-95"
      >
        IDŐPONT MEGERŐSÍTÉSE
      </button>

      <p class="text-[10px] text-slate-400 mt-6 leading-relaxed">
        A gomb megnyomásával véglegesíted a foglalást. <br>
        Ha nem te kezdeményezted, kérlek hagyd figyelmen kívül ezt az oldalt.
      </p>
    </div>
  </div>
</Layout>

<script>
  const btn = document.getElementById('confirm-booking-btn') as HTMLButtonElement;
  
  btn?.addEventListener('click', async () => {
    const id = btn.getAttribute('data-id');
    
    btn.innerText = "Megerősítés...";
    btn.disabled = true;
    btn.style.opacity = "0.7";

    try {
      const res = await fetch(`/api/confirm?id=${id}`);
      
      if (res.ok) {
        window.location.href = '/confirm-booking';
      } else {
        throw new Error("Hiba történt");
      }
    } catch (err) {
      alert("Hiba történt a megerősítés során. Kérlek próbáld újra!");
      btn.innerText = "IDŐPONT MEGERŐSÍTÉSE";
      btn.disabled = false;
      btn.style.opacity = "1";
    }
  });
</script>

<style>
  .animate-fade-in { animation: fadeIn 0.5s ease-out forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .logo { letter-spacing: -1px; }
</style>