---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Impresszum | Nails by Nelly">
  <!-- Mobilbarát margók és párnázás -->
  <section class="max-w-4xl mx-auto px-4 md:px-6 py-12 md:py-20">
    <h1 class="font-serif text-3xl md:text-4xl mb-8 text-stone-800 leading-tight">Impresszum</h1>
    
    <!-- Az elrendezés mobilon is átlátható marad -->
    <div class="text-stone-700 space-y-6 text-sm md:text-base">
      <div class="space-y-3">
        <p><strong>A weboldal tulajdonosa és üzemeltetője:</strong><br> Szekeres-Radványi Nelli</p>
        <p><strong>Székhely:</strong><br>6728 szeged 34. Utca 2</p>
        <p><strong>Adószám:</strong><br>92157444-1-26</p>
        <p><strong>E-mail:</strong><br> <a href="mailto:info@nailsbynelly.hu" class="text-pink-600 hover:underline">info@nailsbynelly.hu</a></p>
        <p><strong>Tárhelyszolgáltató:</strong><br> Vercel Inc. (San Francisco, CA)</p>
        <p><strong>Weboldal készítése:</strong><br> <a href="https://radvanyitamas.hu" target="_blank" rel="noopener noreferrer" class="text-pink-600 hover:underline">Radványi Tamás (radvanyitamas.com)</a></p>
      </div>
    </div>

    <!-- Vissza gomb stílusosabban -->
    <div class="mt-12 pt-8 border-t border-stone-200">
      <a href="/" class="inline-flex items-center text-pink-600 hover:text-pink-700 font-medium transition-colors">
        <span class="mr-2">&larr;</span> Vissza a főoldalra
      </a>
    </div>
  </section>
</Layout>