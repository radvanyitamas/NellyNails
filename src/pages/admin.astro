---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD; 
const authCookie = Astro.cookies.get('admin_auth')?.value;
const isAuthenticated = authCookie === ADMIN_PASSWORD;

if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();
  if (data.get("password") === ADMIN_PASSWORD) {
    Astro.cookies.set('admin_auth', ADMIN_PASSWORD, { path: '/' });
    return Astro.redirect('/admin');
  }
}

let bookings = [];
let priceCategories = [];
let galleryItems = [];
let openingHours = [];
let siteSettings = [];

if (isAuthenticated) {
    const { data: bData } = await supabase.from('bookings').select('*').order('booking_date', { ascending: true });
    const { data: cData } = await supabase.from('price_categories').select('*, prices(*)').order('display_order', { ascending: true });
    const { data: gData } = await supabase.from('gallery').select('*').order('created_at', { ascending: false });
    const { data: hData } = await supabase.from('opening_hours').select('*').order('day_id', { ascending: true });
    const { data: sData } = await supabase.from('site_settings').select('*');
    
    bookings = bData || [];
    priceCategories = cData || [];
    galleryItems = gData || [];
    openingHours = hData || [];
    siteSettings = sData || [];
}

const getSetting = (key) => siteSettings.find(s => s.key === key)?.value || "";
---

<Layout title="Vezérlőpult">
    <div class="min-h-screen bg-[#fdf2f8] font-sans pb-20">
        {!isAuthenticated ? (
            <div class="flex items-center justify-center pt-32 px-6">
                <div class="max-w-md w-full bg-white rounded-[3rem] p-8 md:p-12 shadow-2xl border border-pink-100 text-center">
                    <h1 class="text-3xl font-serif font-bold text-slate-900 mb-8 tracking-tight">Admin Belépés</h1>
                    <form method="POST" class="space-y-6">
                        <input type="password" name="password" placeholder="Jelszó" required class="w-full p-5 rounded-2xl bg-slate-50 border-none ring-1 ring-slate-200 outline-none text-center font-bold focus:ring-2 focus:ring-pink-500 transition-all" />
                        <button type="submit" class="w-full py-5 bg-[#db2777] text-white font-bold rounded-2xl shadow-lg shadow-pink-200 active:scale-95 transition-all">Belépés</button>
                    </form>
                </div>
            </div>
        ) : (
            <div class="max-w-6xl mx-auto px-4 md:px-6 pt-10">
                <div class="flex flex-col md:flex-row justify-between items-center mb-10 gap-4">
                    <div>
                        <h1 class="text-3xl md:text-5xl font-serif font-bold text-slate-900 tracking-tight italic">Vezérlőpult</h1>
                        <p class="text-pink-500 font-medium mt-2 italic">Szia Nelly! ✨</p>
                    </div>
                    <button onclick="document.cookie='admin_auth=;path=/;expires=Thu, 01 Jan 1970 00:00:01 GMT;';location.reload();" class="px-6 py-2 bg-white text-pink-600 font-bold rounded-full shadow-sm border border-pink-100 text-xs uppercase tracking-widest hover:bg-pink-50 transition-all">Kijelentkezés</button>
                </div>

                <div class="flex flex-wrap gap-2 md:gap-4 mb-8">
                    {['Foglalások', 'Árazás', 'Galéria', 'Beállítások'].map((t, i) => (
                        <button class="tab-btn px-6 py-2 md:px-8 md:py-3 rounded-full font-bold text-sm transition-all bg-white text-slate-500 border border-pink-100 data-[active=true]:bg-[#db2777] data-[active=true]:text-white data-[active=true]:shadow-lg" data-target={`sec-${['b','p','g','s'][i]}`} data-active={i === 0}>
                            {t}
                        </button>
                    ))}
                </div>

                <!-- FOGLALÁSOK -->
                <div id="sec-b" class="admin-section block animate-fade-in">
                    <div class="md:hidden space-y-4">
                        {bookings.map((b) => (
                            <div class="bg-white p-4 rounded-2xl shadow border border-pink-50 flex justify-between items-center text-sm">
                                <div>
                                    <p class="font-bold">{b.name}</p>
                                    <p class="text-[10px] text-slate-500">{new Date(b.booking_date).toLocaleString('hu-HU')}</p>
                                </div>
                                <button class="del-booking text-red-400 p-2" data-id={b.id}>Törlés</button>
                            </div>
                        ))}
                    </div>
                    <div class="hidden md:block bg-white rounded-[3rem] shadow-xl border border-pink-50 overflow-hidden">
                        <table class="w-full text-left">
                            <thead class="bg-slate-50 text-[10px] uppercase font-bold text-slate-400">
                                <tr><th class="px-10 py-6">Időpont</th><th class="px-10 py-6">Vendég</th><th class="px-10 py-6">Művelet</th></tr>
                            </thead>
                            <tbody>
                                {bookings.map((b) => (
                                    <tr class="border-t border-slate-50">
                                        <td class="px-10 py-6">{new Date(b.booking_date).toLocaleString('hu-HU')}</td>
                                        <td class="px-10 py-6">{b.name}</td>
                                        <td class="px-10 py-6"><button class="del-booking text-red-500 font-bold" data-id={b.id}>Törlés</button></td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- ÁRAZÁS (Javított mobil elrendezés) -->
                <div id="sec-p" class="admin-section hidden space-y-6 animate-fade-in">
                    {priceCategories.map((cat) => (
                        <div class="bg-white rounded-[2rem] p-6 shadow-xl border border-pink-50">
                            <h3 class="text-xl font-bold mb-4">{cat.name}</h3>
                            <div class="space-y-3">
                                {cat.prices?.map((item) => (
                                    <div class="flex flex-col md:flex-row gap-2 bg-slate-50 p-3 rounded-xl">
                                        <input type="text" value={item.service_name} class="w-full md:w-1/3 p-2 rounded-lg border text-sm" />
                                        <input type="text" value={item.description} class="w-full md:w-1/3 p-2 rounded-lg border text-sm" />
                                        <input type="number" value={item.price_value} class="w-full md:w-20 p-2 rounded-lg border text-sm" />
                                        <button class="save-price bg-pink-600 text-white px-4 py-2 rounded-lg text-sm font-bold" data-id={item.id}>Mentés</button>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>

                <!-- NYITVATARTÁS (Javított mobil elrendezés) -->
                <div id="sec-s" class="admin-section hidden animate-fade-in space-y-6">
                    <div class="bg-white rounded-[2rem] p-6 shadow-xl border border-pink-50">
                        <h2 class="text-xl font-bold mb-4">Nyitvatartás</h2>
                        <form id="admin-hours-form" class="space-y-3">
                            {openingHours.map((day) => (
                                <div class="flex flex-col md:flex-row md:items-center gap-2 p-3 bg-slate-50 rounded-lg">
                                    <span class="w-24 font-bold text-sm">{day.day_name}</span>
                                    <div class="flex items-center gap-2">
                                        <input type="text" name={`open_${day.day_id}`} value={day.open_time} class="w-20 p-2 border rounded" />
                                        <span>-</span>
                                        <input type="text" name={`close_${day.day_id}`} value={day.close_time} class="w-20 p-2 border rounded" />
                                    </div>
                                    <label class="text-xs flex items-center gap-2"><input type="checkbox" name={`closed_${day.day_id}`} checked={day.is_closed} /> Zárva</label>
                                </div>
                            ))}
                            <button type="submit" class="w-full p-4 bg-slate-900 text-white rounded-xl mt-4 font-bold">Frissítés</button>
                        </form>
                    </div>
                </div>
            </div>
        )}
    </div>
</Layout>

<script>
    import { supabase } from '../lib/supabase';

    // Tab kezelés
    document.querySelectorAll('.tab-btn').forEach(btn => btn.addEventListener('click', (e) => {
        document.querySelectorAll('.tab-btn').forEach(b => b.setAttribute('data-active', 'false'));
        (e.currentTarget as HTMLElement).setAttribute('data-active', 'true');
        const target = (e.currentTarget as HTMLElement).dataset.target;
        document.querySelectorAll('.admin-section').forEach(s => s.classList.add('hidden'));
        document.getElementById(target!)?.classList.remove('hidden');
    }));

    // Törlés és Mentés... (logika változatlan)
    document.querySelectorAll('.del-booking').forEach(btn => btn.addEventListener('click', async () => {
        if (!confirm('Törlés?')) return;
        await supabase.from('bookings').delete().eq('id', (btn as HTMLElement).dataset.id);
        location.reload();
    }));
</script>