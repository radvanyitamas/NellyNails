---
// --- BACKEND / SZERVER OLDALI KÓD (Astro Frontmatter) ---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Környezeti változók és sütik (cookies) ellenőrzése a belépéshez
const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD; 
const authCookie = Astro.cookies.get('admin_auth')?.value;
const isAuthenticated = authCookie === ADMIN_PASSWORD;

// Admin belépési jelszó ellenőrzése POST kérés esetén
if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();
  if (data.get("password") === ADMIN_PASSWORD) {
    // Ha jó a jelszó, beállítjuk a sütit és frissítjük az oldalt
    Astro.cookies.set('admin_auth', ADMIN_PASSWORD, { path: '/' });
    return Astro.redirect('/admin');
  }
}

// Kezdőértékek deklarálása a Supabase-ből érkező adatoknak
let bookings = [];
let priceCategories = [];
let galleryItems = [];
let uniqueCategories = [];
let openingHours = [];
let siteSettings = [];

// Ha a felhasználó be van jelentkezve, lekérjük az összes adatot a Supabase-ből
if (isAuthenticated) {
    const { data: bData } = await supabase.from('bookings').select('*').order('booking_date', { ascending: true });
    const { data: cData } = await supabase.from('price_categories').select('*, prices(*)').order('display_order', { ascending: true });
    const { data: gData } = await supabase.from('gallery').select('*').order('created_at', { ascending: false });
    const { data: hData } = await supabase.from('opening_hours').select('*').order('day_id', { ascending: true });
    const { data: sData } = await supabase.from('site_settings').select('*');
    
    // Adatok átadása a lokális változóknak (ha nincs adat, üres tömböt kapnak)
    bookings = bData || [];
    priceCategories = cData || [];
    galleryItems = gData || [];
    openingHours = hData || [];
    siteSettings = sData || [];
    
    // Egyedi kategóriák kiszűrése a galériából a lenyíló ajánlásokhoz
    uniqueCategories = [...new Set(galleryItems.map(item => item.category))];
}

// Segédfüggvény az oldalbeállítások kulcs-érték alapú lekéréséhez
const getSetting = (key) => siteSettings.find(s => s.key === key)?.value || "";
---

<Layout title="Vezérlőpult">
    <div class="min-h-screen bg-[#fdf2f8] font-sans pb-20">
        {!isAuthenticated ? (
            <div class="flex items-center justify-center pt-32 px-6">
                <div class="max-w-md w-full bg-white rounded-[3rem] p-12 shadow-2xl border border-pink-100 text-center">
                    <h1 class="text-3xl font-serif font-bold text-slate-900 mb-8 tracking-tight">Admin Belépés</h1>
                    <form method="POST" class="space-y-6">
                        <input type="password" name="password" placeholder="Jelszó" required class="w-full p-5 rounded-2xl bg-slate-50 border-none ring-1 ring-slate-200 outline-none text-center font-bold focus:ring-2 focus:ring-pink-500 transition-all" />
                        <button type="submit" class="w-full py-5 bg-[#db2777] text-white font-bold rounded-2xl shadow-lg shadow-pink-200 active:scale-95 transition-all">Belépés</button>
                    </form>
                </div>
            </div>
        ) : (
            <div class="max-w-6xl mx-auto px-6 pt-10">
                <div class="flex justify-between items-center mb-10">
                    <div>
                        <h1 class="text-5xl font-serif font-bold text-slate-900 tracking-tight italic">Vezérlőpult</h1>
                        <p class="text-pink-500 font-medium mt-2 italic">Szia Nelly! ✨</p>
                    </div>
                    <button onclick="document.cookie='admin_auth=;path=/;expires=Thu, 01 Jan 1970 00:00:01 GMT;';location.reload();" class="px-6 py-2 bg-white text-pink-600 font-bold rounded-full shadow-sm border border-pink-100 text-xs uppercase tracking-widest hover:bg-pink-50 transition-all">Kijelentkezés</button>
                </div>

                <div class="flex flex-wrap gap-4 mb-8">
                    <button class="tab-btn px-8 py-3 rounded-full font-bold transition-all bg-[#db2777] text-white shadow-lg" data-target="sec-b">Foglalások</button>
                    <button class="tab-btn px-8 py-3 rounded-full font-bold transition-all bg-white text-slate-500 border border-pink-100" data-target="sec-p">Árazás</button>
                    <button class="tab-btn px-8 py-3 rounded-full font-bold transition-all bg-white text-slate-500 border border-pink-100" data-target="sec-g">Galéria</button>
                    <button class="tab-btn px-8 py-3 rounded-full font-bold transition-all bg-white text-slate-500 border border-pink-100" data-target="sec-s">Beállítások</button>
                </div>

                <div id="sec-b" class="admin-section block animate-fade-in">
                    <div class="bg-white rounded-[3rem] shadow-2xl shadow-pink-200/20 border border-pink-50 overflow-x-auto">
                        <table class="w-full text-left min-w-[700px]">
                            <thead class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] border-b border-slate-50">
                                <tr>
                                    <th class="px-10 py-6">Időpont</th>
                                    <th class="px-10 py-6">Vendég</th>
                                    <th class="px-10 py-6">E-mail</th>
                                    <th class="px-10 py-6 text-center">Állapot</th>
                                    <th class="px-10 py-6 text-right">Művelet</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                {bookings.map((b) => (
                                    <tr class="hover:bg-pink-50/10 transition-all">
                                        <td class="px-10 py-8 font-bold text-slate-900">{new Date(b.booking_date).toLocaleString('hu-HU', { month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</td>
                                        <td class="px-10 py-8 font-bold text-slate-800">{b.name}<br/><span class="text-xs text-slate-400 font-normal italic">{b.phone}</span></td>
                                        <td class="px-10 py-8 text-sm text-slate-600">{b.email}</td>
                                        <td class="px-10 py-8 text-center">{b.status === 'confirmed' ? <span class="px-4 py-1 rounded-full bg-green-100 text-green-600 text-[10px] font-bold uppercase tracking-widest border border-green-200">Megerősítve</span> : <span class="px-4 py-1 rounded-full bg-amber-100 text-amber-600 text-[10px] font-bold uppercase tracking-widest border border-amber-200">Függőben</span>}</td>
                                        <td class="px-10 py-8 text-right"><button class="del-booking p-4 bg-slate-50 text-slate-300 hover:text-red-500 transition-all rounded-full" data-id={b.id}><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button></td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div id="sec-p" class="admin-section hidden space-y-12 animate-fade-in">
                    <div class="bg-slate-900 rounded-[3.5rem] p-12 text-white shadow-2xl relative overflow-hidden">
                        <h2 class="text-3xl font-serif font-bold mb-6">Új kategória hozzáadása</h2>
                        <div class="flex flex-col md:flex-row gap-4 relative z-10">
                            <input type="text" id="new-cat-name" placeholder="Pl: Gél Lakk, Műköröm építés..." class="flex-1 p-5 rounded-2xl bg-white/10 border-none ring-1 ring-white/20 outline-none text-white focus:ring-2 focus:ring-pink-500 transition-all" />
                            <button id="add-cat-btn" class="px-10 py-5 bg-pink-600 text-white font-bold rounded-2xl hover:bg-pink-500 transition-all shadow-xl active:scale-95">Létrehozás</button>
                        </div>
                    </div>
                    {priceCategories.map((cat) => (
                        <div class="bg-white rounded-[3.5rem] p-10 md:p-14 shadow-xl border border-pink-50">
                            <div class="flex justify-between items-center mb-10 border-b border-pink-50 pb-6">
                                <h3 class="text-4xl font-serif font-bold text-slate-800 tracking-tight">{cat.name}</h3>
                                <button class="del-cat px-4 py-2 bg-red-50 text-red-400 hover:text-red-600 rounded-full text-[10px] font-bold uppercase tracking-widest transition-all" data-id={cat.id}>Törlés</button>
                            </div>
                            <div class="space-y-6">
                                {cat.prices && cat.prices.map((item) => (
                                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 p-5 bg-slate-50/50 rounded-3xl border border-slate-100 items-center">
                                        <input type="text" value={item.service_name} class="service-name p-4 rounded-2xl border-none ring-1 ring-slate-200 outline-none focus:ring-2 focus:ring-pink-500 bg-white" />
                                        <input type="text" value={item.description} placeholder="Leírás" class="service-desc p-4 rounded-2xl border-none ring-1 ring-slate-200 text-sm outline-none bg-white italic" />
                                        <input type="number" value={item.price_value} class="service-price p-4 rounded-2xl border-none ring-1 ring-slate-200 font-bold text-pink-600 outline-none bg-white" />
                                        <div class="flex gap-2">
                                            <button class="save-price flex-1 py-4 bg-green-500 text-white rounded-2xl text-xs font-bold hover:bg-green-600 transition-all" data-id={item.id}>Mentés</button>
                                            <button class="del-price p-4 bg-white text-red-300 hover:text-red-500 rounded-2xl border border-red-50 transition-all" data-id={item.id}><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
                                        </div>
                                    </div>
                                ))}
                                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 p-8 bg-pink-50/20 rounded-[2.5rem] border-2 border-dashed border-pink-100 items-center mt-10">
                                    <input type="text" placeholder="Új szolgáltatás" class="new-name p-4 rounded-2xl border-none ring-1 ring-pink-100 outline-none bg-white text-sm" />
                                    <input type="text" placeholder="Leírás" class="new-desc p-4 rounded-2xl border-none ring-1 ring-pink-100 outline-none bg-white text-sm" />
                                    <input type="number" placeholder="Ár" class="new-price p-4 rounded-2xl border-none ring-1 ring-pink-100 outline-none bg-white" />
                                    <button class="add-new-price py-4 bg-slate-900 text-white rounded-2xl font-bold hover:bg-pink-600 transition-all shadow-lg" data-cat-id={cat.id}>+ Hozzáadás</button>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                <div id="sec-g" class="admin-section hidden space-y-12 animate-fade-in">
                    <div class="bg-white rounded-[3.5rem] p-10 md:p-12 shadow-2xl border border-pink-100 relative overflow-hidden">
                        <h2 class="text-4xl font-serif font-bold text-slate-900 mb-8 tracking-tight">Új munka hozzáadása</h2>
                        <form id="gallery-upload-form" class="grid grid-cols-1 md:grid-cols-2 gap-6 relative z-10">
                            <div class="space-y-2">
                                <label class="text-[10px] uppercase tracking-widest font-bold text-slate-400 ml-4">Kép címe</label>
                                <input type="text" id="g-title" placeholder="Pl: Rose Gold Csillogás" required class="w-full p-5 rounded-2xl bg-slate-50 border-none ring-1 ring-slate-200 outline-none transition-all" />
                            </div>
                            <div class="space-y-2">
                                <label class="text-[10px] uppercase tracking-widest font-bold text-slate-400 ml-4">Kategória (Válassz vagy írj újat)</label>
                                <input list="category-suggestions" id="g-category" placeholder="Pl: Zselé építés..." required class="w-full p-5 rounded-2xl bg-slate-50 border-none ring-1 ring-slate-200 outline-none transition-all" />
                                <datalist id="category-suggestions">
                                    {uniqueCategories.map(cat => <option value={cat} />)}
                                </datalist>
                            </div>
                            <div class="md:col-span-2 space-y-2">
                                <label class="text-[10px] uppercase tracking-widest font-bold text-slate-400 ml-4">Fotó kiválasztása</label>
                                <input type="file" id="g-file" accept="image/*" required class="w-full p-5 rounded-2xl bg-pink-50/30 border-2 border-dashed border-pink-100 text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-bold file:bg-pink-600 file:text-white" />
                            </div>
                            <button type="submit" id="g-submit-btn" class="md:col-span-2 py-6 bg-pink-600 text-white font-bold rounded-3xl shadow-xl shadow-pink-200 active:scale-95 transition-all">Kép mentése</button>
                        </form>
                    </div>
                    
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                        {galleryItems.map((item) => (
                            <div class="group relative aspect-[4/5] rounded-[2rem] overflow-hidden bg-white shadow-lg border border-pink-50 transition-all hover:shadow-2xl">
                                <img src={item.src} alt={item.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                                <div class="absolute inset-0 bg-red-600/80 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-all">
                                    <button class="del-gallery-item py-3 px-6 bg-white text-red-600 font-bold rounded-xl text-xs uppercase tracking-widest" data-id={item.id} data-path={item.storage_path}>Törlés</button>
                                </div>
                                <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full border border-pink-100">
                                    <span class="text-[10px] font-bold text-pink-600 uppercase tracking-widest">{item.category}</span>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <div id="sec-s" class="admin-section hidden space-y-8 animate-fade-in">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="bg-white rounded-[3rem] p-10 shadow-xl border border-pink-50">
                            <h2 class="text-2xl font-serif font-bold text-slate-800 mb-6 border-b border-pink-50 pb-4">Kapcsolati adatok</h2>
                            <form id="admin-settings-form" class="space-y-6">
                                <div class="space-y-2">
                                    <label class="text-[10px] uppercase tracking-widest font-bold text-slate-400 ml-2">Email cím</label>
                                    <input type="email" name="contact_email" value={getSetting('contact_email')} class="w-full p-4 rounded-2xl bg-slate-50 border-none ring-1 ring-slate-200 outline-none focus:ring-2 focus:ring-pink-500 transition-all" />
                                </div>
                                <div class="space-y-2">
                                    <label class="text-[10px] uppercase tracking-widest font-bold text-slate-400 ml-2">Telefonszám</label>
                                    <input type="text" name="contact_phone" value={getSetting('contact_phone')} class="w-full p-4 rounded-2xl bg-slate-50 border-none ring-1 ring-slate-200 outline-none focus:ring-2 focus:ring-pink-500 transition-all" />
                                </div>
                                <div class="space-y-2">
                                    <label class="text-[10px] uppercase tracking-widest font-bold text-slate-400 ml-2">Cím (Helyszín)</label>
                                    <input type="text" name="contact_address" value={getSetting('contact_address')} class="w-full p-4 rounded-2xl bg-slate-50 border-none ring-1 ring-slate-200 outline-none focus:ring-2 focus:ring-pink-500 transition-all" />
                                </div>
                                <button type="submit" class="w-full py-4 bg-pink-600 text-white font-bold rounded-2xl shadow-lg hover:bg-pink-700 transition-all active:scale-95">Adatok mentése</button>
                            </form>
                        </div>
                        
                        <div class="bg-white rounded-[3rem] p-10 shadow-xl border border-pink-50">
                            <h2 class="text-2xl font-serif font-bold text-slate-800 mb-6 border-b border-pink-50 pb-4">Napi nyitvatartás</h2>
                            <form id="admin-hours-form" class="space-y-4">
                                {openingHours.map((day) => (
                                    <div class="grid grid-cols-4 items-center gap-2 p-3 bg-slate-50/50 rounded-2xl border border-slate-100">
                                        <span class="text-xs font-bold text-slate-600">{day.day_name}</span>
                                        <input type="text" name={`open_${day.day_id}`} value={day.open_time} data-day={day.day_id} class="time-input p-2 rounded-lg border-none ring-1 ring-slate-200 text-xs text-center outline-none bg-white focus:ring-pink-500 disabled:bg-slate-100" disabled={day.is_closed} />
                                        <input type="text" name={`close_${day.day_id}`} value={day.close_time} data-day={day.day_id} class="time-input p-2 rounded-lg border-none ring-1 ring-slate-200 text-xs text-center outline-none bg-white focus:ring-pink-500 disabled:bg-slate-100" disabled={day.is_closed} />
                                        <label class="flex items-center justify-center gap-1 cursor-pointer">
                                            <input type="checkbox" name={`closed_${day.day_id}`} checked={day.is_closed} class="closed-checkbox w-4 h-4 accent-pink-600" data-day={day.day_id} />
                                            <span class="text-[10px] font-bold text-slate-400 uppercase">Zárva</span>
                                        </label>
                                    </div>
                                ))}
                                <button type="submit" class="w-full py-4 bg-slate-900 text-white font-bold rounded-2xl shadow-lg hover:bg-black transition-all active:scale-95 mt-4">Időpontok frissítése</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        )}
    </div>
</Layout>

<script>
    // --- KLIENS OLDALI JAVASCRIPT / TYPESCRIPT ---
    import { supabase } from '../lib/supabase';

    document.addEventListener('DOMContentLoaded', () => {
        const tabs = document.querySelectorAll('.tab-btn');
        const sections = document.querySelectorAll('.admin-section');

        // Navigációs fülek logikája (Tab váltó)
        function showTab(targetId: string) {
            sections.forEach(s => s.classList.add('hidden'));
            const target = document.getElementById(targetId);
            if (target) target.classList.remove('hidden');
            tabs.forEach(t => {
                if (t.getAttribute('data-target') === targetId) {
                    t.classList.add('bg-[#db2777]', 'text-white', 'shadow-lg');
                    t.classList.remove('bg-white', 'text-slate-500');
                } else {
                    t.classList.remove('bg-[#db2777]', 'text-white', 'shadow-lg');
                    t.classList.add('bg-white', 'text-slate-500');
                }
            });
            // Mentjük az aktív fület munkamenetbe, hogy frissítéskor ne ugorjon vissza az elsőre
            sessionStorage.setItem('activeAdminTab', targetId);
        }

        const savedTab = sessionStorage.getItem('activeAdminTab') || 'sec-b';
        showTab(savedTab);

        tabs.forEach(tab => tab.addEventListener('click', () => showTab(tab.getAttribute('data-target') || 'sec-b')));

        // Nyitvatartás: Zárva gomb kattintásra tiltja az idő mezőket
        document.querySelectorAll('.closed-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', (e) => {
                const dayId = (e.target as HTMLInputElement).dataset.day;
                const inputs = document.querySelectorAll(`.time-input[data-day="${dayId}"]`);
                const isChecked = (e.target as HTMLInputElement).checked;
                inputs.forEach((input: any) => {
                    input.disabled = isChecked;
                    if (!isChecked) {
                        if (input.name.startsWith('open_')) input.value = "15:30";
                        if (input.name.startsWith('close_')) input.value = "17:00";
                    }
                });
            });
        });

        // Általános beállítások form beküldése
        document.getElementById('admin-settings-form')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target as HTMLFormElement);
            for (const [key, value] of formData.entries()) await supabase.from('site_settings').upsert({ key, value });
            alert('Mentve!');
            location.reload();
        });

        // Nyitvatartás form beküldése
        document.getElementById('admin-hours-form')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target as HTMLFormElement);
            for (let i = 1; i <= 7; i++) {
                await supabase.from('opening_hours').update({
                    open_time: formData.get(`open_${i}`),
                    close_time: formData.get(`close_${i}`),
                    is_closed: formData.get(`closed_${i}`) === 'on'
                }).eq('day_id', i);
            }
            alert('Frissítve!');
            location.reload();
        });

        // Foglalás törlése (API Route hívással)
        document.querySelectorAll('.del-booking').forEach(btn => btn.addEventListener('click', async (e) => {
            const btn = e.currentTarget as HTMLElement;
            const id = btn.dataset.id;
            const reason = prompt('Add meg a törlés indokát:');

            if (!confirm('Biztosan törlöd a foglalást és küldesz emailt?')) return;

            const response = await fetch('/api/cancel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, reason })
            });

            if (response.ok) {
                alert('Sikeres törlés és email küldés!');
                location.reload();
            } else {
                alert('Hiba történt.');
            }
        }));

        // Árak frissítése
        document.querySelectorAll('.save-price').forEach(btn => btn.addEventListener('click', async (e) => {
            const container = (e.currentTarget as HTMLElement).closest('.grid');
            const data = {
                service_name: (container?.querySelector('.service-name') as HTMLInputElement).value,
                description: (container?.querySelector('.service-desc') as HTMLInputElement).value,
                price_value: parseInt((container?.querySelector('.service-price') as HTMLInputElement).value)
            };
            await supabase.from('prices').update(data).eq('id', (e.currentTarget as HTMLElement).dataset.id);
            alert('Ár frissítve!');
            location.reload();
        }));

        // --- ÚJ / JAVÍTOTT RÉSZ: Galéria képfeltöltés kezelése ---
        document.getElementById('gallery-upload-form')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const btn = document.getElementById('g-submit-btn') as HTMLButtonElement;
            btn.disabled = true;
            btn.innerText = "Feltöltés...";

            const fileEl = document.getElementById('g-file') as HTMLInputElement;
            const file = fileEl.files?.[0];
            const title = (document.getElementById('g-title') as HTMLInputElement).value;
            const category = (document.getElementById('g-category') as HTMLInputElement).value;

            if (!file) {
                btn.disabled = false;
                btn.innerText = "Kép mentése";
                return;
            }

            // Egyedi fájlnév generálás időbélyeggel
            const fileName = `${Date.now()}-${file.name}`;

            // 1. Storage feltöltés a 'gallery' bucketbe
            const { data: storageData, error: storageError } = await supabase.storage
                .from('gallery')
                .upload(fileName, file, {
                    cacheControl: '3600',
                    upsert: false
                });

            if (storageError) {
                console.error("Storage hiba:", storageError);
                alert(`Feltöltési hiba: ${storageError.message}`);
                btn.disabled = false;
                btn.innerText = "Kép mentése";
                return;
            }

            // 2. Publikus URL lekérése
            const { data: { publicUrl } } = supabase.storage.from('gallery').getPublicUrl(fileName);

            // 3. Mentés az adatbázis 'gallery' táblájába
            const { error: dbError } = await supabase.from('gallery').insert([{
                title,
                category,
                src: publicUrl,
                storage_path: fileName
            }]);

            if (dbError) {
                console.error("Adatbázis hiba:", dbError.message);
                alert("Adatbázis mentési hiba történt!");
                btn.disabled = false;
                btn.innerText = "Kép mentése";
                return;
            }

            alert("Kép sikeresen mentve!");
            location.reload();
        });

        // Galéria elem törlése (Adatbázisból ÉS Storage-ból is)
        document.querySelectorAll('.del-gallery-item').forEach(btn => btn.addEventListener('click', async (e) => {
            const target = e.currentTarget as HTMLElement;
            const id = target.dataset.id;
            const path = target.dataset.path;

            if (!confirm('Biztosan törlöd a képet?')) return;

            // Ha van elmentett storage path, onnan is töröljük a fizikai fájlt
            if (path) {
                await supabase.storage.from('gallery').remove([path]);
            }

            // Törlés az adatbázis táblából
            await supabase.from('gallery').delete().eq('id', id);
            
            alert("Kép törölve!");
            location.reload();
        }));
    });
</script>

<style>
    .animate-fade-in { animation: fadeIn 0.3s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
</style>