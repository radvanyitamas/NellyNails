---
// src/layouts/Layout.astro
import '../styles/global.css';
import Footer from '../components/Footer.astro';

import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

const { title } = Astro.props;
---

<!doctype html>
<html lang="hu" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
        
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<meta name="generator" content={Astro.generator} />
		<title>{title || "Szekeres-Radványi Nelly Nails"}</title>
		
        <link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@200..800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-white min-h-screen flex flex-col antialiased text-slate-900">
		
		<main class="grow w-full">
			<slot />
		</main>

		<Footer />

		<Analytics />
		<SpeedInsights />
	</body>
</html>

<style is:global>
	html {
		margin: 0;
		padding: 0;
		width: 100%;
		/* Megakadályozza a vízszintes görgetést, ha egy elem túl széles lenne */
		overflow-x: hidden;
	}
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		overflow-x: hidden;
	}
</style>