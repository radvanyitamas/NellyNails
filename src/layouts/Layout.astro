---
// src/layouts/Layout.astro
import '../styles/global.css';
import Footer from '../components/Footer.astro';

const { title } = Astro.props;
---

<!doctype html>
<html lang="hu">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
        
        <link rel="icon" href="/favicon.ico" sizes="any" />
        
        <link rel="icon" href="/icon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="generator" content={Astro.generator} />
		<title>{title || "Szekeres-Radványi Nelly Nails"}</title>
		
        <link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@200..800&display=swap" rel="stylesheet">
	</head>
	<body id="top" class="bg-white min-h-screen flex flex-col">
		<main class="grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>