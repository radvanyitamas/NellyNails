{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/book/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/booking/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/settings/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/cancel/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/categories/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/confirm/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/get-slots/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/services/?$",
			"dest": "_render"
		},
		{
			"src": "^/kezeles/?$",
			"dest": "_render"
		},
		{
			"src": "^/koszonjuk/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}